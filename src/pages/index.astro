---
import Layout from "../components/Layout.astro";
import RoomAvailabilityPanel from "../components/RoomAvailabilityPanel.astro";
import { BUILDINGS, CLOSE, OPEN } from "../lib/campus";
import { formatTime12 } from "../lib/time";
import { canberraNow, listBookingsForBuilding, roomLiveStatus } from "../lib/bookings";

const now = canberraNow();
// Counts come from the same helper as the room panel, so they agree.
const markers = BUILDINGS.filter((b) => b.lngLat).map((b) => {
  const dayBookings = listBookingsForBuilding(b.id, now.date);
  return {
    id: b.id,
    name: b.name,
    code: b.code,
    lngLat: b.lngLat!,
    image: b.image,
    total: b.rooms.length,
    available: b.rooms.filter((r) => roomLiveStatus(r, dayBookings, now.time).status === "available").length,
  };
});
---

<Layout title="ANU Room Finder — Campus map" fullBleed>
  <h1 class="visually-hidden">Find a study or tutorial room</h1>
  <div class="campus-map-frame">
    <div
      id="campus-map"
      class="campus-map"
      role="region"
      aria-label="Map of ANU campus with building markers"
      data-markers={JSON.stringify(markers)}
    >
    </div>
    <!-- Outside #campus-map so MapLibre never touches it; plain HTML, so it shows without JS. -->
    <div class="map-overlay">
      <p class="map-overlay-tagline">Pick a building to see free rooms</p>
      <a href="#help">Help and all buildings</a>
    </div>
  </div>

  <section id="help" class="map-help" aria-labelledby="help-title">
    <h2 id="help-title">Help</h2>
    <p>
      The map shows campus buildings with bookable study and tutorial rooms.
      Hover or focus a building's marker to see its name and how many of its
      rooms are free right now.
    </p>
    <p>
      Click a marker to open the room availability panel. It lists every room
      in that building: free rooms show how long they stay free, and booked
      rooms show who has them and until when. Press Escape or the close button
      to shut it.
    </p>
    <p>
      To book, use <strong>Schedule booking</strong> at the bottom of the
      panel. It opens the building's full booking page, where you pick a day,
      a room and a time. {`Rooms can be booked from ${formatTime12(OPEN)} to ${formatTime12(CLOSE)}, up to two weeks ahead.`}
    </p>
    <p>Some buildings aren't on the map yet. Every building is listed here:</p>
    <ul class="building-links">
      {
        BUILDINGS.map((b) => (
          <li>
            <a href={`/building/${b.id}/`} data-building-id={b.id} data-building-name={b.name}>{b.name}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <RoomAvailabilityPanel />
</Layout>

<script>
  import * as maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  // Bundling moves MapLibre away from its sibling worker file, so hand it
  // Vite's bundled worker URL explicitly.
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import { Protocol } from "pmtiles";
  import { campusStyle } from "../lib/map-style";

  interface MarkerData {
    id: string;
    name: string;
    code: string;
    lngLat: [number, number];
    image?: string;
    total: number;
    available: number;
  }

  const container = document.getElementById("campus-map");
  if (container) {
    const markers: MarkerData[] = JSON.parse(container.dataset.markers ?? "[]");

    maplibregl.setWorkerUrl(workerUrl);
    maplibregl.addProtocol("pmtiles", new Protocol().tile);

    const map = new maplibregl.Map({
      container,
      style: campusStyle,
      center: [149.1194, -35.2776],
      zoom: 16.3,
      minZoom: 15,
      maxZoom: 18.5,
      maxBounds: [
        [149.106, -35.289],
        [149.132, -35.268],
      ],
      attributionControl: { compact: true },
      dragRotate: false,
      pitchWithRotate: false,
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
    map.touchZoomRotate.disableRotation();

    const el = (tag: string, className: string, text?: string) => {
      const node = document.createElement(tag);
      node.className = className;
      if (text) node.textContent = text;
      return node;
    };

    const placed = markers.map((m) => {
      const link = document.createElement("a");
      link.className = "map-marker";
      link.href = `/building/${m.id}/`;
      link.dataset.buildingId = m.id;
      link.dataset.buildingName = m.name;
      link.setAttribute(
        "aria-label",
        `${m.name}, ${m.available} of ${m.total} rooms available. Click to see its rooms and book`,
      );

      const card = el("span", "marker-card");
      card.setAttribute("aria-hidden", "true");
      let image: HTMLElement;
      if (m.image) {
        const img = document.createElement("img");
        img.className = "marker-card-image";
        img.src = m.image;
        img.alt = "";
        image = img;
      } else {
        image = el("span", "marker-card-image");
      }
      card.append(
        image,
        el("span", "marker-card-name", m.name),
        el("span", "marker-card-meta", `${m.available} of ${m.total} rooms available`),
      );
      link.append(el("span", "marker-pin"), card);

      new maplibregl.Marker({ element: link, anchor: "bottom" }).setLngLat(m.lngLat).addTo(map);
      return { link, lngLat: m.lngLat };
    });

    // Cards open upward; flip them below the pin near the top edge so the
    // map's overflow clipping doesn't cut them off.
    const flipCards = () => {
      const limit = container.clientHeight / 3;
      for (const p of placed) {
        p.link.classList.toggle("card-below", map.project(p.lngLat).y < limit);
      }
    };
    map.on("load", flipCards);
    map.on("move", flipCards);
  }
</script>
