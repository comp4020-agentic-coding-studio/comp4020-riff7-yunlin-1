---
// The full day schedule, secondary to the room cards: rows are rooms, columns
// 30-minute slots. The chosen time window is highlighted and, today, the
// current slot is marked. Every free cell is a Book link (?room=&start=), and
// BookingDialog's script opens the confirm dialog from it in place.
import type { Building } from "../lib/campus";
import type { GridRow } from "../lib/bookings";
import { formatTime12 } from "../lib/time";

interface Props {
  building: Building;
  grid: GridRow[];
  dayLabel: string;
  windowStart: string;
  windowEnd: string;
  // Canberra time, only on today's page.
  nowTime?: string;
  hrefFor: (roomId: string, start: string) => string;
}

const { building, grid, dayLabel, windowStart, windowEnd, nowTime, hrefFor } = Astro.props;

const inWindow = (start: string) => start >= windowStart && start < windowEnd;
const isNow = (cell: { start: string; end: string }) => !!nowTime && cell.start <= nowTime && nowTime < cell.end;
const stateLabel = { booked: "Booked", closed: "Closed", past: "Past" };
---

<div class="schedule-body">
  <ul class="calendar-legend">
    <li><span class="legend-swatch slot-free"></span>Free, select to book</li>
    <li><span class="legend-swatch slot-booked"></span>Booked</li>
    <li><span class="legend-swatch slot-closed"></span>Closed</li>
    <li><span class="legend-swatch slot-past"></span>Past</li>
    <li><span class="legend-swatch legend-window"></span>Your chosen time</li>
  </ul>

  <a class="skip-link" href="#after-schedule">Skip past the schedule</a>
  <div class="calendar-wrap">
    <table class="calendar">
      <caption class="visually-hidden">{building.name} availability, {dayLabel}</caption>
      <thead>
        <tr>
          <th scope="col">Room</th>
          {grid[0]?.cells.map((cell) => (
            <th
              scope="col"
              class:list={["slot-head", { "slot-head-window": inWindow(cell.start), "slot-head-now": isNow(cell) }]}
            >
              <span class={cell.start.endsWith(":00") ? "slot-hour" : "visually-hidden"}>
                {cell.start.endsWith(":00") ? formatTime12(cell.start).replace(":00", "") : formatTime12(cell.start)}
              </span>
              {isNow(cell) && <span class="slot-now-label">Now</span>}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {grid.map((row) => (
          <tr data-room-id={row.room.id} data-room-name={row.room.name} data-room-capacity={row.room.capacity}>
            <th scope="row">
              <span class="room-name">{row.room.name}</span>
              <span class="room-meta">{[row.room.level, `${row.room.capacity} seats`].filter(Boolean).join(" · ")}</span>
            </th>
            {row.cells.map((cell) => {
              const classes = ["slot", `slot-${cell.state}`, { "slot-window": inWindow(cell.start), "slot-now": isNow(cell) }];
              return cell.state === "free" ? (
                <td class:list={classes} data-start={cell.start} data-end={cell.end}>
                  <a
                    href={hrefFor(row.room.id, cell.start)}
                    data-book
                    aria-label={`Book ${row.room.name}, ${dayLabel}, from ${formatTime12(cell.start)}`}
                  ></a>
                </td>
              ) : (
                <td class:list={classes} data-start={cell.start} data-end={cell.end}>
                  <span class="visually-hidden">{stateLabel[cell.state]}</span>
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <span id="after-schedule" tabindex="-1"></span>
</div>
